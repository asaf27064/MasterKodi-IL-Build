<?xml version="1.0" encoding="UTF-8"?>
<!-- POV-style top bar (copied from plugin.video.pov episodes.xml at Asaf's
     request 2026-08-09): slide-down panel, poster right, right-aligned Hebrew
     text, icon-only round buttons with zoom-on-focus, countdown bar.
     Differences from POV's original: our addon icon instead of the POV logo,
     Hebrew labels, and the countdown drains over the WHOLE intro segment
     (window property fed from overlay.py) instead of a fixed 20s. -->
<window type="dialog" id="14001">
    <defaultcontrol always="true">3101</defaultcontrol>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="image">
            <animation effect="fade" start="0" end="100" delay="400" time="500">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
            <left>35</left>
            <top>20</top>
            <width>60</width>
            <height>60</height>
            <aspectratio aligny="top">keep</aspectratio>
            <texture>$INFO[Window.Property(mk.skip.icon)]</texture>
        </control>
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="slide" start="0,-268" end="0,0" time="350" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="slide" start="0,0" end="0,-268" time="250" />
            </animation>
            <left>35</left>
            <top>0</top>
            <width>1850</width>
            <height>260</height>
            <control type="image">
                <right>0</right>
                <top>85</top>
                <width max="170">auto</width>
                <height>200</height>
                <aspectratio>stretch</aspectratio>
                <texture>$INFO[Window.Property(mk.skip.poster)]</texture>
            </control>
            <control type="label">
                <top>5</top>
                <height>30</height>
                <font>font12</font>
                <align>right</align>
                <aligny>top</aligny>
                <label>$INFO[Window.Property(mk.skip.title)]</label>
                <textcolor>FFB7B4BB</textcolor>
                <autoscroll>true</autoscroll>
            </control>
            <control type="label">
                <top>40</top>
                <height>30</height>
                <font>font12</font>
                <align>right</align>
                <aligny>top</aligny>
                <label>[B]$INFO[Window.Property(mk.skip.prompt)][/B]</label>
                <textcolor>FFB7B4BB</textcolor>
            </control>
            <control type="grouplist">
                <orientation>vertical</orientation>
                <align>center</align>
                <itemgap>20</itemgap>
                <right>180</right>
                <top>85</top>
                <width>80</width>
                <height>200</height>
                <control type="button" id="3101">
                    <description>Skip</description>
                    <animation effect="zoom" start="100" end="102" time="50" tween="sine" easing="inout" center="auto">Focus</animation>
                    <animation effect="zoom" start="102" end="100" time="50" tween="sine" easing="inout" center="auto">Unfocus</animation>
                    <left>0</left>
                    <width>70</width>
                    <height>45</height>
                    <onleft>3102</onleft>
                    <onright>3102</onright>
                    <label />
                    <font>font10</font>
                    <textcolor>FFB7B4BB</textcolor>
                    <focusedcolor>FF302F2F</focusedcolor>
                    <texturefocus colordiffuse="FFB7B4BB">skip_yes.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347">skip_yes.png</texturenofocus>
                    <align>center</align>
                </control>
                <control type="button" id="3102">
                    <description>Close</description>
                    <animation effect="zoom" start="100" end="102" time="50" tween="sine" easing="inout" center="auto">Focus</animation>
                    <animation effect="zoom" start="102" end="100" time="50" tween="sine" easing="inout" center="auto">Unfocus</animation>
                    <left>0</left>
                    <width>70</width>
                    <height>45</height>
                    <onleft>3101</onleft>
                    <onright>3101</onright>
                    <label />
                    <font>font10</font>
                    <textcolor>FFB7B4BB</textcolor>
                    <focusedcolor>FF302F2F</focusedcolor>
                    <texturefocus colordiffuse="FFB7B4BB">skip_no.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347">skip_no.png</texturenofocus>
                    <align>center</align>
                </control>
            </control>
            <control type="progress" id="3108">
                <description>countdown (drains over the whole intro)</description>
                <top>290</top>
                <right>0</right>
                <width>260</width>
                <height>17</height>
                <reveal>true</reveal>
            </control>
        </control>
    </controls>
</window>
