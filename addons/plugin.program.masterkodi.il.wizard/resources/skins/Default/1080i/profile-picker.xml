<?xml version="1.0" encoding="UTF-8"?>
<!-- MasterKodi IL - "מי צופה?" profile picker (resources/libs/profiles.py).
     Shown at start-up when there is more than one profile, and from every
     skin's power menu. Generic fonts + own white.png: identical on any skin.
     Controls: 100 the cards, 300 "הוסף פרופיל", 301 close. -->
<window type="dialog" id="3104">
    <defaultcontrol always="true">100</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="F2000000">white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="18FFFFFF">fanart.jpg</texture>
            <aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>6</height>
            <texture colordiffuse="FFFFD700">white.png</texture>
        </control>
        <control type="image">
            <centerleft>50%</centerleft><top>110</top><width>120</width><height>120</height>
            <texture>logo.png</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="label">
            <left>0</left><top>250</top><width>1920</width><height>70</height>
            <align>center</align><font>font14</font>
            <textcolor>FFFFD700</textcolor>
            <label>$INFO[Window.Property(heading)]</label>
        </control>
        <control type="label">
            <left>0</left><top>316</top><width>1920</width><height>36</height>
            <align>center</align><font>font12</font>
            <textcolor>FF9AA3B0</textcolor>
            <label>$INFO[Window.Property(summary)]</label>
        </control>

        <!-- profile cards, centred row -->
        <control type="list" id="100">
            <left>0</left><top>400</top><width>1920</width><height>400</height>
            <orientation>horizontal</orientation>
            <onup>100</onup><ondown>300</ondown>
            <onleft>100</onleft><onright>100</onright>
            <scrolltime tween="cubic" easing="out">200</scrolltime>
            <itemlayout width="320" height="400">
                <control type="image">
                    <left>20</left><top>20</top><width>280</width><height>280</height>
                    <texture colordiffuse="FF1B1F28" border="20">rounded.png</texture>
                </control>
                <control type="image">
                    <left>20</left><top>20</top><width>280</width><height>280</height>
                    <texture colordiffuse="FF22262E">white.png</texture>
                </control>
                <control type="image">
                    <left>70</left><top>60</top><width>180</width><height>180</height>
                    <texture fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
                    <aspectratio>keep</aspectratio>
                </control>
                <control type="image">
                    <left>20</left><top>250</top><width>280</width><height>50</height>
                    <texture colordiffuse="CC27AE60">white.png</texture>
                    <visible>!String.IsEmpty(ListItem.Property(kids))</visible>
                </control>
                <control type="label">
                    <left>20</left><top>250</top><width>280</width><height>50</height>
                    <align>center</align><aligny>center</aligny><font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(kids)]</label>
                    <visible>!String.IsEmpty(ListItem.Property(kids))</visible>
                </control>
                <control type="label">
                    <left>10</left><top>312</top><width>300</width><height>44</height>
                    <align>center</align><font>font13</font>
                    <textcolor>FFC9D2DE</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>10</left><top>352</top><width>300</width><height>30</height>
                    <align>center</align><font>font10</font>
                    <textcolor>FF7A838F</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
            <focusedlayout width="320" height="400">
                <control type="image">
                    <left>14</left><top>14</top><width>292</width><height>292</height>
                    <texture colordiffuse="FFFFD700">white.png</texture>
                </control>
                <control type="image">
                    <left>20</left><top>20</top><width>280</width><height>280</height>
                    <texture colordiffuse="FF2A2F3A">white.png</texture>
                </control>
                <control type="image">
                    <left>70</left><top>60</top><width>180</width><height>180</height>
                    <texture fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
                    <aspectratio>keep</aspectratio>
                </control>
                <control type="image">
                    <left>20</left><top>250</top><width>280</width><height>50</height>
                    <texture colordiffuse="FF27AE60">white.png</texture>
                    <visible>!String.IsEmpty(ListItem.Property(kids))</visible>
                </control>
                <control type="label">
                    <left>20</left><top>250</top><width>280</width><height>50</height>
                    <align>center</align><aligny>center</aligny><font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(kids)]</label>
                    <visible>!String.IsEmpty(ListItem.Property(kids))</visible>
                </control>
                <control type="label">
                    <left>10</left><top>312</top><width>300</width><height>44</height>
                    <align>center</align><font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>10</left><top>352</top><width>300</width><height>30</height>
                    <align>center</align><font>font10</font>
                    <textcolor>FFFFD700</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>

        <control type="group">
            <left>0</left><top>860</top>
            <control type="button" id="300">
                <left>700</left><top>0</top><width>250</width><height>60</height>
                <font>font13</font><align>center</align>
                <textcolor>FFC9D2DE</textcolor><focusedcolor>FF101418</focusedcolor>
                <texturenofocus colordiffuse="33FFFFFF" border="4">white.png</texturenofocus>
                <texturefocus colordiffuse="FFFFD700" border="4">white.png</texturefocus>
                <label>הוסף פרופיל</label>
                <onup>100</onup><ondown>300</ondown><onleft>301</onleft><onright>300</onright>
            </control>
            <control type="button" id="301">
                <left>970</left><top>0</top><width>250</width><height>60</height>
                <font>font13</font><align>center</align>
                <textcolor>FFC9D2DE</textcolor><focusedcolor>FF101418</focusedcolor>
                <texturenofocus colordiffuse="33FFFFFF" border="4">white.png</texturenofocus>
                <texturefocus colordiffuse="FFFFD700" border="4">white.png</texturefocus>
                <label>$INFO[Window.Property(closelabel)]</label>
                <onup>100</onup><ondown>301</ondown><onleft>301</onleft><onright>300</onright>
            </control>
        </control>
        <control type="label">
            <left>0</left><bottom>36</bottom><width>1920</width><height>34</height>
            <align>center</align><font>font10</font>
            <textcolor>FF6B7380</textcolor>
            <label>OK לכניסה  |  פרופיל נעול יבקש קוד</label>
        </control>
    </controls>
</window>
